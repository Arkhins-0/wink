# Copy to .env and fill in. .env is gitignored.

# --- Server (wink.arkhins.com) ----------------------------------------------
# Postgres — your database connection
DATABASE_URL=""
DATABASE_URL_POOLED=""

# Storage — S3-compatible object storage
AWS_ENDPOINT_URL_S3=""
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="us-east-2"
S3_BUCKET="wink-neon-storage"

# Email (Brevo transactional). Blank key = no email is sent.
EMAIL_PROVIDER="brevo"
BREVO_API_KEY=""
EMAIL_FROM="arkhins@arkhins.com"
EMAIL_FROM_NAME="Wink"

# Push (Firebase Cloud Messaging, server side): the Firebase service-account
# JSON, base64-encoded (`base64 -w0 service-account.json`). Same value on Vercel.
FIREBASE_SERVICE_ACCOUNT=""

# Push in the browser (Firebase web app). All five or none; not secret.
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_PROJECT_ID=""
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=""
NEXT_PUBLIC_FIREBASE_APP_ID=""
NEXT_PUBLIC_FIREBASE_VAPID_KEY=""

# --- App build ---------------------------------------------------------------
# Only the keys below are compiled into the Android app (see app/build.gradle.kts).
WINK_BASE_URL="https://wink.arkhins.com"
WINK_UPDATE_URL=""
WINK_GITHUB_REPO="Arkhins-0/wink"

# Release signing (optional; defaults to ./release.keystore.jks, alias "wink")
# WINK_KEYSTORE_PATH="release.keystore.jks"
# WINK_KEYSTORE_PASSWORD=""
# WINK_KEY_ALIAS="wink"
# WINK_KEY_PASSWORD=""

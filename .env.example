# Copy to .env and fill in. .env is gitignored.

# --- Server (wink.arkhins.com) ----------------------------------------------
# Postgres — your database connection
DATABASE_URL=""
DATABASE_URL_POOLED=""

# Storage — S3-compatible object storage
AWS_ENDPOINT_URL_S3=""
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="us-east-2"
S3_BUCKET="wink-neon-storage"

# --- App build ---------------------------------------------------------------
# Only the keys below are compiled into the Android app (see app/build.gradle.kts).
WINK_BASE_URL="https://wink.arkhins.com"
WINK_UPDATE_URL=""
WINK_GITHUB_REPO="Arkhins-0/wink"

# Release signing (optional; defaults to ./release.keystore.jks, alias "wink")
# WINK_KEYSTORE_PATH="release.keystore.jks"
# WINK_KEYSTORE_PASSWORD=""
# WINK_KEY_ALIAS="wink"
# WINK_KEY_PASSWORD=""

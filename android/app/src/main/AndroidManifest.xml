<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- To notice at once when the phone loses its connection (the no-connection icon). -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- So the app can install its own update, downloaded from a release. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Popups for messages and race changes. Asked on first launch. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Documents are saved to Downloads/Wink. Only older Android needs a permission for that. -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />
    <!-- The QR scanner on the account page. Asked when it is opened. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- Voice notes and sharing where you are, from the message box. Asked on first launch. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- So the phone does not put the app to sleep and hold back its popups. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <!-- Which apps can open a downloaded document. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:mimeType="*/*" />
        </intent>
    </queries>

    <application
        android:name=".WinkApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.Wink.Starting">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.Wink.Starting">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- A tapped push notification (the server's click_action), with
                 the in-app link to open in its "link" extra. -->
            <intent-filter>
                <action android:name="OPEN_LINK" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <!-- Links into the app open here when it is installed (verified
                 against the site's /.well-known/assetlinks.json): invites,
                 password resets, verification codes, and every signed-in page.
                 The sign-in page itself and /download stay in the browser. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="wink.arkhins.com" />
                <data android:pathPrefix="/invite/" />
                <data android:pathPrefix="/reset/" />
                <data android:pathPrefix="/v/" />
                <data android:path="/home" />
                <data android:pathPrefix="/home?" />
                <data android:path="/schedule" />
                <data android:pathPrefix="/w/" />
                <data android:path="/chats" />
                <data android:pathPrefix="/chats/" />
                <data android:path="/people" />
                <data android:pathPrefix="/people/" />
                <data android:path="/account" />
                <data android:path="/archive" />
                <data android:pathPrefix="/archive/" />
            </intent-filter>
        </activity>

        <service
            android:name=".push.WinkMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="wink_alerts" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_notification" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_color"
            android:resource="@color/gold" />

        <!-- Lends the downloaded update APK to the system installer, and
             downloaded documents to the app that opens them on older Android. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.updates"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
